# Copied/synced into compose env for local infra.
# App-level secrets live in the repo-root .env (from .env.template).

COMPOSE_PROJECT_NAME=council-local

# Redis
REDIS_PORT=6379

# Jaeger UI (OTLP from apps goes to OTEL Collector, which forwards to Jaeger)
JAEGER_UI_PORT=16686

# OpenTelemetry Collector (OTLP front door)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROM_PORT=8889

# Postgres (only used with --postgres / compose profile postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=council
POSTGRES_PORT=5432

# Observability profile (--observability)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PHOENIX_PORT=6006
PHOENIX_OTLP_PORT=4319
LOKI_PORT=3100

# coa_observability_api container (observability profile)
COA_OBS_API_PORT=8088
PROMETHEUS_METRICS_PORT=9108

# Task gates for the container (default false). Set true to enable fan-out.
OBS_TASK_EMIT_METRICS=false
OBS_TASK_EMIT_TRACES=false
OBS_TASK_EMIT_LOGS=false
OBS_TASK_EMIT_LLMOPS=false
