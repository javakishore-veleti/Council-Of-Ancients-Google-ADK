# Copied/synced into compose env for local infra.
# App-level secrets live in the repo-root .env (from .env.template).

COMPOSE_PROJECT_NAME=council-local

# Redis
REDIS_PORT=6379

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# Postgres (only used with --postgres / compose profile postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=council
POSTGRES_PORT=5432
