        {
          "expr": "histogram_quantile(0.95, sum(rate(council_llm_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 }
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens / min (prompt vs completion)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(council_llm_tokens_total{token_type=\"prompt\"}[5m])) * 60 or vector(0)",
          "legendFormat": "prompt",
          "refId": "A"
        },
        {
          "expr": "sum(rate(council_llm_tokens_total{token_type=\"completion\"}[5m])) * 60 or vector(0)",
          "legendFormat": "completion",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM latency (p50 / p95)",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(council_llm_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(council_llm_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "type": "timeseries",
