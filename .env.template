# Copy to .env and fill in values. .env is gitignored.

# --- Google / Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_USE_ENTERPRISE=true

# Full regional Model Armor template resource names (same region for both)
MODEL_ARMOR_PROMPT_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/council-prompt-screening
MODEL_ARMOR_RESPONSE_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/council-response-screening

# HTTP server listen port
PORT=8080

# --- Database ---
# Default: sqlite (no Docker DB required).
# Override: set DB_BACKEND=postgres and start local Postgres via:
#   CICD/Local/docker-all-up.sh --postgres
DB_BACKEND=sqlite
# Used when DB_BACKEND=postgres (user/password: postgres/postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/council
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=council
POSTGRES_PORT=5432

# --- Local infra (CICD/Local Docker) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
JAEGER_UI_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
